{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tailorbirdcv",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "tailorbirdcv", "serve", "--port", "8000", "--no-browser"],
      "port": 8000
    },
    {
      "name": "tailorbirdcv-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": ["TAILORBIRDCV_ENGINE=fake", "uv", "run", "tailorbirdcv", "serve", "--port", "8001", "--no-browser"],
      "port": 8001
    },
    {
      "name": "tailorbirdcv-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
