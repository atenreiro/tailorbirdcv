# ---- TailorbirdCV: personal data never enters the repository ----------------------------------
# The data folder (profile, applications, settings, access key) and the owner's local notes.
private/
CLAUDE.local.md
.access-key
# Resumes and their outputs anywhere in the tree; the only Word file shipped is the empty template.
*.pdf
*.docx
!tailorbirdcv/data/templates/base.docx
*.doc
*.rtf
*.odt
# Word and LibreOffice lock files
~$*
.~lock.*#

# ---- Secrets -------------------------------------------------------------------------------
.env
.env.*
.envrc
*.pem
*.key
*.p12
.pypirc

# ---- Python ----------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# ---- Node (web/ has its own .gitignore for node_modules and dist) ----------------------------
node_modules/
*.log

# ---- Editors and operating systems -------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude Code: local settings and worktrees -------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
